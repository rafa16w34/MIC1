module DATAPATH_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLOCK;
reg [7:0] IN_MBR;
reg [31:0] IN_MEM;
reg LOAD;
reg [35:0] MIR;
// wires                                               
wire [31:0] A_BUS;
wire [31:0] ADDRESS;
wire [31:0] B_BUS;
wire [31:0] C_BUS;
wire N;
wire [7:0] OUT_MBR;
wire [31:0] OUT_MEM;
wire [31:0] PC;
wire Z;

wire sampler;                             

// assign statements (if any)                          
DATAPATH i1 (
// port map - connection between master ports and signals/registers   
	.A_BUS(A_BUS),
	.ADDRESS(ADDRESS),
	.B_BUS(B_BUS),
	.C_BUS(C_BUS),
	.CLOCK(CLOCK),
	.IN_MBR(IN_MBR),
	.IN_MEM(IN_MEM),
	.LOAD(LOAD),
	.MIR(MIR),
	.N(N),
	.OUT_MBR(OUT_MBR),
	.OUT_MEM(OUT_MEM),
	.PC(PC),
	.Z(Z)
);
// MIR[ 35 ]
initial
begin
	MIR[35] = 1'b0;
end 
